{
    "name": "Monokai Vibrant Modified (Dark +)",
    "type": "dark",
    "tokenColors": [
        { "settings": { "foreground": "#F6F6F6" } },
        {
            "name": "Comment",
            "scope": ["comment", "string.comment"],
            "settings": { "foreground": "#5c6370", "fontStyle": "italic" }
        },
        { "name": "String", "scope": "string", "settings": { "foreground": "#FFD945" } },
        {
            "name": "Punctuation Template Expression",
            "scope": "punctuation.definition.template-expression.begin, punctuation.definition.template-expression.end, punctuation.section.embedded",
            "settings": { "foreground": "#FF3F4F" }
        },
        { "name": "TemplateString", "scope": "meta.string.template", "settings": { "foreground": "#E5A422" } },
        { "name": "Meta", "scope": "meta", "settings": { "foreground": "#f8f8f0" } },
        { "name": "Number", "scope": "constant.numeric", "settings": { "foreground": "#E373CE" } },
        {
            "name": "Embeded String Begin and End",
            "scope": ["string.embedded.begin", "string.embedded.end"],
            "settings": { "foreground": "#E373CE" }
        },
        { "name": "Embeded String", "scope": "string.embedded", "settings": { "foreground": "#98c379" } },
        { "name": "Built-in constant", "scope": "constant.language", "settings": { "foreground": "#E373CE" } },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#E373CE" }
        },
        {
            "name": "Language Variable",
            "scope": "variable.language",
            "settings": { "foreground": "#FF3F4F", "fontStyle": "italic" }
        },
        {
            "name": "Variable",
            "scope": ["variable.readwrite", "variable.readwrite.other.block"],
            "settings": { "foreground": "#00a0e4" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "keyword.operator.logical", "keyword.operator.constructor"],
            "settings": { "foreground": "#FF3F4F" }
        },
        { "name": "Keyword Operator", "scope": "keyword.operator", "settings": { "foreground": "#FF3F4F" } },
        { "name": "Storage", "scope": "storage", "settings": { "foreground": "#FF3F4F", "fontStyle": "italic" } },
        { "name": "Storage type", "scope": "storage.type", "settings": { "foreground": "#FF3F4F" } },
        {
            "name": "Class name",
            "scope": [
                "entity.name.class",
                "entity.name.module",
                "entity.name.type",
                "storage.identifier",
                "support.class"
            ],
            "settings": { "foreground": "#00a0e4" }
        },
        {
            "name": "Variable Object",
            "scope": ["meta.block.switch.c", "variable.other.object"],
            "settings": { "foreground": "#00a0e4" }
        },
        {
            "name": "Other variable",
            "scope": ["variable.other.property", "variable.other.block"],
            "settings": { "foreground": "#f8f8f0" }
        },
        { "name": "Inherited class", "scope": "entity.other.inherited-class", "settings": { "foreground": "#81F900" } },
        {
            "name": "Function name",
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#81F900" }
        },
        { "name": "Library function", "scope": "support.function", "settings": { "foreground": "#19D1E5" } },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic", "foreground": "#FF9700" }
        },
        { "name": "Function call", "scope": "entity.name.function-call", "settings": { "foreground": "#f8f8f0" } },
        {
            "name": "Builtin Functions",
            "scope": ["function.support.builtin", "function.support.core"],
            "settings": { "foreground": "#81F900" }
        },
        {
            "name": "Tag name",
            "scope": ["entity.name.tag", "entity.name.tag.class.js", "entity.name.tag.class.jsx"],
            "settings": { "foreground": "#FF3F4F" }
        },
        {
            "name": "Tag Class and ID",
            "scope": ["entity.name.tag.class", "entity.name.tag.id"],
            "settings": { "foreground": "#19D1E5" }
        },
        { "name": "Tag attribute", "scope": "entity.other.attribute-name", "settings": { "foreground": "#81F900" } },
        { "name": "Library constant", "scope": "support.constant", "settings": { "foreground": "#19D1E5" } },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.variable"],
            "settings": { "foreground": "#19D1E5" }
        },
        { "name": "Json Property", "scope": "support.dictionary.json", "settings": { "foreground": "#19D1E5" } },
        {
            "name": "StyleSheet Property name",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.scss",
                "support.type.property-name.less",
                "support.type.property-name.sass"
            ],
            "settings": { "foreground": "#6AEBF7" }
        },
        {
            "name": "StyleSheet Property value",
            "scope": [
                "support.constant.css",
                "support.constant.scss",
                "support.constant.less",
                "support.constant.sass"
            ],
            "settings": { "foreground": "#98c379" }
        },
        {
            "name": "StyleSheet Variable",
            "scope": ["variable.css", "variable.scss", "variable.less", "variable.sass"],
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "StyleSheet Variable String",
            "scope": ["variable.css.string", "variable.scss.string", "variable.less.string", "variable.sass.string"],
            "settings": { "foreground": "#e5c07b" }
        },
        {
            "name": "StyleSheet Unit",
            "scope": ["unit.css", "unit.scss", "unit.less", "unit.sass"],
            "settings": { "foreground": "#c678dd" }
        },
        {
            "name": "StyleSheet Number",
            "scope": [
                "constant.numeric.css",
                "constant.numeric.scss",
                "constant.numeric.less",
                "constant.numeric.sass"
            ],
            "settings": { "foreground": "#E373CE" }
        },
        {
            "name": "StyleSheet Function",
            "scope": ["function.css", "function.scss", "function.less", "function.sass"],
            "settings": { "foreground": "#56b6c2" }
        },
        { "name": "Library variable", "scope": "support.other.variable", "settings": { "fontStyle": "" } },
        { "name": "Invalid", "scope": "invalid", "settings": { "foreground": "#F8F8F0" } },
        { "name": "Invalid deprecated", "scope": "invalid.deprecated", "settings": { "foreground": "#F8F8F0" } },
        {
            "name": "JSON String",
            "scope": "structure.dictionary.property-name.json",
            "settings": { "foreground": "#56b6c2" }
        },
        { "name": "Link", "scope": "string.detected-link", "settings": { "foreground": "#00a0e4" } },
        { "name": "diff.header", "scope": ["meta.diff", "meta.diff.header"], "settings": { "foreground": "#75715E" } },
        { "name": "diff.deleted", "scope": "markup.deleted", "settings": { "foreground": "#E542FF" } },
        { "name": "diff.inserted", "scope": "markup.inserted", "settings": { "foreground": "#e5c07b" } },
        { "name": "diff.changed", "scope": "markup.changed", "settings": { "foreground": "#e5c07b" } },
        { "scope": "constant.numeric.line-number.find-in-files - match", "settings": { "foreground": "#56b6c2A0" } },
        { "scope": "entity.name.filename.find-in-files", "settings": { "foreground": "#e5c07b" } },
        {
            "name": "Markup: Emphasis",
            "scope": "markup.italic, markup.italic.markdown",
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup: Emphasis Punctuation",
            "scope": "punctuation.definition.italic.markdown",
            "settings": { "fontStyle": "", "foreground": "#696969" }
        },
        {
            "name": "Markdown: Link",
            "scope": "markup.underline.link.markdown",
            "settings": { "foreground": "#00a0e4" }
        },
        { "name": "Markdown: Bold", "scope": "markup.bold.markdown", "settings": { "fontStyle": "bold" } },
        {
            "name": "Markdown: Bold Punctuation",
            "scope": "punctuation.definition.bold.markdown",
            "settings": { "fontStyle": "", "foreground": "#919191" }
        },
        {
            "name": "Markdown: Heading",
            "scope": "markup.heading.markdown",
            "settings": { "fontStyle": "bold", "foreground": "#FF3F4F" }
        },
        {
            "name": "Markdown: Heading",
            "scope": "punctuation.definition.heading.markdown",
            "settings": { "fontStyle": "", "foreground": "#919191" }
        },
        { "name": "Markdown: Quote", "scope": "markup.quote.markdown", "settings": { "foreground": "#6FD80D" } },
        {
            "name": "Markdown: Separator",
            "scope": "meta.separator.markdown",
            "settings": { "foreground": "#E542FF", "fontStyle": "bold" }
        },
        {
            "name": "Markdown: Raw",
            "scope": "markup.raw.inline.markdown, markup.raw.block.markdown",
            "settings": { "foreground": "#56b6c2" }
        },
        {
            "name": "Markdown: List Punctuation",
            "scope": "punctuation.definition.list_item.markdown",
            "settings": { "fontStyle": "bold", "foreground": "#ffffff" }
        },
        { "name": "JSDoc: Variable", "scope": "variable.other.jsdoc", "settings": { "foreground": "#9496a5" } },
        { "name": "this keyword", "scope": "variable.language.this", "settings": { "foreground": "#79C0FF" } },
        {
            "name": "Variable declaration and reference",
            "scope": [
                "variable.other.constant.ts",
                "meta.definition.variable.ts",
                "meta.var-single-variable.expr.ts",
                "meta.var.expr.ts",
                "variable.other.object.ts",
                "variable.other.readwrite.ts",
                "variable.other.readwrite.alias.ts"
            ],
            "settings": { "foreground": "#79C0FF" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "newOperator": "#FF3F4F",
        "stringLiteral": "#FFD945",
        "customLiteral": "#81F900",
        "numberLiteral": "#E373CE"
    },
    "colors": {
        "activityBar.background": "#333333",
        "activityBar.foreground": "#FFFFFF",
        "activityBarBadge.background": "#007ACC",
        "activityBarBadge.foreground": "#FFFFFF",
        "editor.background": "#1E1E1E",
        "editor.foreground": "#D4D4D4",
        "editor.lineHighlightBackground": "#2A2A2A",
        "editor.selectionBackground": "#264F78",
        "editorCursor.foreground": "#AEAFAD",
        "editorIndentGuide.background": "#404040",
        "editorLineNumber.foreground": "#858585",
        "editorWhitespace.foreground": "#404040",
        "sideBar.background": "#252526",
        "sideBar.foreground": "#CCCCCC",
        "sideBarSectionHeader.background": "#2C2C2C",
        "statusBar.background": "#007ACC",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.noFolderBackground": "#68217A",
        "tab.activeBackground": "#1E1E1E",
        "tab.inactiveBackground": "#2D2D2D",
        "tab.activeForeground": "#FFFFFF",
        "tab.inactiveForeground": "#CCCCCC",
        "titleBar.activeBackground": "#3C3C3C",
        "titleBar.activeForeground": "#CCCCCC",
        "titleBar.inactiveBackground": "#2C2C2C",
        "titleBar.inactiveForeground": "#CCCCCC",
        "editorSuggestWidget.background": "#252526",
        "editorSuggestWidget.border": "#454545",
        "editorSuggestWidget.selectedBackground": "#062F4A",
        "activityBar.border": "#333333",
        "sideBar.border": "#3F3F46",
        "editorGroupHeader.tabsBackground": "#252526",
        "editorGroup.border": "#444444"
    }
}
